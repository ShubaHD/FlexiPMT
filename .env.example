# Local / Vercel — connection pooler (Supabase: Transaction mode, port 6543)
# Example: postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct connection for Prisma migrate (Supabase: Session mode / Direct, port 5432)
# Example: postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
